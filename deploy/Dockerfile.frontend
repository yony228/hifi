# ============================================================
# Hify Frontend — 多阶段构建
# 阶段 1：Node 编译 Vue 3 项目
# 阶段 2：Nginx 提供静态文件 + 反向代理
#
# 国内加速构建：
#   docker compose build --build-arg DOCKER_MIRROR=docker.1ms.run/
# 或在 compose 文件中取消注释 ARG 行替换默认值
# ============================================================
ARG DOCKER_MIRROR=

# --- 阶段 1：编译 ---
FROM ${DOCKER_MIRROR}node:22-alpine AS builder

WORKDIR /build

COPY hify-web/package.json hify-web/package-lock.json ./

RUN npm ci

COPY hify-web/ ./

RUN npm run build

# --- 阶段 2：运行 ---
FROM ${DOCKER_MIRROR}nginx:alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80
